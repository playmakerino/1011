<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- BtvnActivity loads the homework page. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Sorts the grid by how often each app is opened (LaunchCounts). Granted over ADB:
         appops set com.gathin.tvhome GET_USAGE_STATS allow -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Needed since Android 10 to read the Wi-Fi network name for the gear's network row. Never requested at
         runtime: build-and-install grants it with pm grant. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:ignore="CoarseFineLocation" />

    <!-- Android 11+ package visibility: the apps shown as tiles, and the settings pages the menus open. -->
    <queries>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <!-- The tile menu offers App info only where this resolves (SystemSettings.appInfo). -->
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.TvHome"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Listed in the TV's own app list, so it can be opened from another home screen too. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- market://launch?id=<package>: package-name app launches from the Android TV Remote service,
             normally served by the stock launcher. -->
        <activity
            android:name=".AppLaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="market" android:host="launch" />
            </intent-filter>
        </activity>

        <!-- The "Bài tập" tile (homework page). A leanback entry point of its own, so AppAdapter shows it among
             the apps; its own task, so Back returns to Home. -->
        <activity
            android:name=".BtvnActivity"
            android:exported="true"
            android:label="@string/btvn_label"
            android:icon="@drawable/ic_btvn"
            android:banner="@drawable/banner_btvn"
            android:taskAffinity="com.gathin.tvhome.btvn"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The clock screensaver, started by Home itself after home_idle_clock_minutes without input. -->
        <activity
            android:name=".ClockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- The same clock as the system screensaver: pick it in Settings, or `settings put secure
             screensaver_components com.gathin.tvhome/.ClockDream` over adb. -->
        <service
            android:name=".ClockDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
