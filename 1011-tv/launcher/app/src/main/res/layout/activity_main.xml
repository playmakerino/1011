<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- YouTube-style header: the section title, and the gear at the right. It reaches past the grid's sides:
             the title and the gear glyph (10dp in from its circle) both sit 28dp from the screen edge. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-28dp"
            android:layout_marginEnd="-18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/section_apps"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@string/font_medium" />

            <!-- Like YouTube's rail icons: no background at rest, a white circle while focused. -->
            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                android:tint="@drawable/pill_text"
                android:background="@drawable/yt_icon_bg"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusDown="@+id/grid" />
        </LinearLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip, so the focus ring of an edge
             tile is not cut off. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The white focus ring, moved onto the focused tile (FocusRing). -->
    <com.gathin.tvhome.FocusRing
        android:id="@+id/ring"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
