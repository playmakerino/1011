<?xml version="1.0" encoding="utf-8"?>
<!-- Languages the launcher is translated into. Lets Android 13+ give the launcher its own language
     ("cmd locale set-app-locales"), since TVs rarely offer every language system-wide. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="vi" />
</locale-config>
